#!/usr/bin/env bash
# commit-fully — Recursively commit and push all submodules and the main repo
# to all configured upstreams. Ensures all submodules are initialized, on a
# branch, and properly committed/pushed.
#
# Constitution §2.1 "Multi-upstream push is the norm"
# Constitution §3 "Submodule changes propagate through submodule commits first"
# Constitution §1.1 "Mutation-paired gates — every gate has a paired mutation"

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"

export SUBMODULES_HOME="$PROJECT_ROOT"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*"; }

# Check if we're in a git repo
check_git_repo() {
    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        log_error "Not a git repository: $(pwd)"
        return 1
    fi
    return 0
}

# Ensure submodules are initialized and cloned
ensure_submodules() {
    log_info "Ensuring submodules are initialized and cloned..."
    
    # Initialize submodules if needed
    if ! git submodule status | grep -q '^ '; then
        log_info "Initializing submodules..."
        git submodule update --init --recursive
    fi
    
    # Check for uninitialized submodules
    local uninitialized
    uninitialized=$(git submodule status | grep '^-' | awk '{print $2}')
    if [ -n "$uninitialized" ]; then
        log_warn "Found uninitialized submodules, initializing..."
        git submodule update --init --recursive
    fi
    
    log_success "All submodules initialized"
    return 0
}

# Ensure repo is on a branch (not detached HEAD)
ensure_on_branch() {
    local repo_path="$1"
    cd "$repo_path"
    
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
    
    if [ -z "$branch" ]; then
        log_warn "Repository at $repo_path is in detached HEAD state"
        # Try to find the default branch from origin
        local default_branch
        default_branch=$(git remote show origin 2>/dev/null | grep "HEAD branch" | sed 's/.*: //' || echo "main")
        
        if [ -n "$default_branch" ] && [ "$default_branch" != "(unknown)" ]; then
            log_info "Checking out default branch: $default_branch"
            if git show-ref --verify --quiet "refs/heads/$default_branch"; then
                git checkout "$default_branch"
            else
                git checkout -b "$default_branch" "origin/$default_branch" 2>/dev/null || {
                    log_warn "Could not checkout $default_branch, trying main..."
                    git checkout -b main origin/main 2>/dev/null || git checkout main 2>/dev/null || {
                        log_error "Cannot determine/create branch for $repo_path"
                        return 1
                    }
                }
            fi
        else
            log_error "Cannot determine default branch for $repo_path"
            return 1
        fi
    else
        log_info "Repository at $repo_path is on branch: $branch"
    fi
    return 0
}

# Get immediate submodules (not recursive) for a given path
get_immediate_submodules() {
    local base_path="$1"
    cd "$base_path"
    # Only get direct submodules, not recursive - filter out . and ..
    git submodule status 2>/dev/null | awk '{print $2}' | grep -v '^\.$' | grep -v '^\./$' | sort -u
}

# Commit and push a single repository
commit_and_push_repo() {
    local repo_path="$1"
    local commit_msg="${2:-}"
    
    cd "$repo_path" || {
        log_error "Failed to cd to $repo_path"
        return 1
    }
    
    if ! check_git_repo; then
        return 1
    fi
    
    if ! ensure_on_branch "$repo_path"; then
        return 1
    fi
    
    # Check for changes
    if git diff --quiet && git diff --cached --quiet; then
        log_info "No changes to commit in $(basename "$repo_path")"
        return 0
    fi
    
    # Generate commit message if not provided
    local msg="$commit_msg"
    if [ -z "$msg" ]; then
        local session_id
        session_id=$(($(date +%s%N)/1000000))
        msg="Auto-commit $session_id"
    fi
    
    log_info "Committing changes in $(basename "$repo_path") with message: $msg"
    
    if git add -A; then
        if git commit -m "$msg"; then
            log_success "Committed successfully"
        else
            log_error "Commit failed"
            return 1
        fi
    else
        log_error "git add failed"
        return 1
    fi
    
    # Push to all upstreams using the project's push_all script
    if [ -f "$PROJECT_ROOT/Upstreamable/push_all" ]; then
        log_info "Pushing to all upstreams..."
        if bash "$PROJECT_ROOT/Upstreamable/push_all"; then
            log_success "Pushed to all upstreams"
        else
            log_error "Push to upstreams failed"
            return 1
        fi
    elif [ -f "$repo_path/Upstreamable/push_all" ]; then
        log_info "Pushing to all upstreams (local)..."
        if bash "$repo_path/Upstreamable/push_all"; then
            log_success "Pushed to all upstreams"
        else
            log_error "Push to upstreams failed"
            return 1
        fi
    else
        log_warn "No push_all script found, attempting manual push..."
        # Fallback: push to all remotes
        for remote in $(git remote); do
            if [ "$remote" != "origin" ]; then
                log_info "Pushing to $remote..."
                git push "$remote" HEAD || log_warn "Push to $remote failed"
            fi
        done
        # Push tags
        git push --tags >/dev/null 2>&1 && log_success "Tags pushed" || log_warn "Tag push failed"
    fi
    
    return 0
}

# Process submodules for a given repo (one level only)
process_submodules() {
    local base_path="$1"
    local commit_msg="${2:-}"
    
    # Get immediate submodules only
    local submodules
    submodules=$(get_immediate_submodules "$base_path")
    
    if [ -z "$submodules" ]; then
        log_info "No submodules found in $(basename "$base_path")"
        return 0
    fi
    
    log_info "Processing submodules in $(basename "$base_path"):"
    
    # Process each submodule
    local failed=0
    echo "$submodules" | while read -r submodule; do
        # Skip empty lines and . entries
        [ -z "$submodule" ] && continue
        [ "$submodule" = "." ] && continue
        [ "$submodule" = "./" ] && continue
        
        local sub_path="$base_path/$submodule"
        # Normalize path - handle relative paths
        sub_path=$(realpath "$sub_path" 2>/dev/null || echo "$sub_path")
        
        if [ -d "$sub_path" ]; then
            log_info "→ Processing submodule: $submodule"
            if ! commit_and_push_repo "$sub_path" "$commit_msg"; then
                log_error "Failed to commit/push submodule: $submodule"
                failed=1
            fi
        else
            log_warn "Submodule path not found: $sub_path (may need initialization)"
        fi
    done
    
    return $failed
}

# Main function
main() {
    local commit_msg="${1:-}"
    
    log_info "Starting commit-fully from project root: $PROJECT_ROOT"
    log_info "Commit message: ${commit_msg:-'(auto-generated)'}"
    echo
    
    cd "$PROJECT_ROOT" || {
        log_error "Failed to cd to project root"
        exit 1
    }
    
    # Step 1: Ensure all submodules are initialized
    if ! ensure_submodules; then
        log_error "Failed to initialize submodules"
        exit 1
    fi
    echo
    
    # Step 2: Process all immediate submodules (bottom-up: leaves first)
    log_info "=== Processing submodules ==="
    if ! process_submodules "$PROJECT_ROOT" "$commit_msg"; then
        log_error "Submodule processing failed"
        exit 1
    fi
    echo
    
    # Step 3: Commit and push the main repository
    log_info "=== Processing main repository ==="
    if ! commit_and_push_repo "$PROJECT_ROOT" "$commit_msg"; then
        log_error "Main repository commit/push failed"
        exit 1
    fi
    echo
    
    # Step 4: Verify all remotes received the commits
    log_info "=== Verifying all upstreams received commits ==="
    local verification_failed=0
    
    # Check main repo
    cd "$PROJECT_ROOT"
    for remote in $(git remote); do
        if [ "$remote" != "origin" ]; then
            log_info "Verifying $remote..."
            if git ls-remote --exit-code "$remote" HEAD >/dev/null 2>&1; then
                log_success "  $remote: OK"
            else
                log_error "  $remote: FAILED - commit not found"
                verification_failed=1
            fi
        fi
    done
    
    # Check submodules
    local submodules
    submodules=$(get_immediate_submodules "$PROJECT_ROOT")
    if [ -n "$submodules" ]; then
        echo "$submodules" | while read -r submodule; do
            [ -z "$submodule" ] && continue
            [ "$submodule" = "." ] && continue
            [ "$submodule" = "./" ] && continue
            
            local sub_path="$PROJECT_ROOT/$submodule"
            if [ -d "$sub_path" ]; then
                cd "$sub_path"
                for remote in $(git remote); do
                    if [ "$remote" != "origin" ]; then
                        if git ls-remote --exit-code "$remote" HEAD >/dev/null 2>&1; then
                            log_success "  $submodule -> $remote: OK"
                        else
                            log_error "  $submodule -> $remote: FAILED"
                            verification_failed=1
                        fi
                    fi
                done
            fi
        done
    fi
    
    echo
    if [ $verification_failed -eq 0 ]; then
        log_success "=== ALL COMMITS VERIFIED ON ALL UPSTREAMS ==="
    else
        log_error "=== VERIFICATION FAILED - Some upstreams missing commits ==="
        exit 1
    fi
    
    log_success "commit-fully completed successfully!"
}

main "$@"
